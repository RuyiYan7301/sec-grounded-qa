{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "secqa-v0.2-change-packet",
  "title": "Change packet for one target 10-K (Part B), DRAFT for review",
  "type": "object",
  "additionalProperties": false,
  "required": ["case", "system", "target_filing_accession", "numeric_changes", "revision_checks", "item1a_changes"],
  "properties": {
    "case": {"type": "string", "pattern": "^[A-Z]+_FY20[0-9]{2}$"},
    "system": {"const": "v0.2"},
    "target_filing_accession": {"type": "string", "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"},
    "numeric_changes": {"type": "array", "items": {"$ref": "#/$defs/numeric_change"}},
    "revision_checks": {"type": "array", "items": {"$ref": "#/$defs/revision_check"}},
    "item1a_changes": {"type": "array", "items": {"$ref": "#/$defs/item1a_change"}}
  },
  "$defs": {
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fy", "value", "unit", "concept", "period_end", "accession"],
      "properties": {
        "fy": {"type": "string", "pattern": "^FY20[0-9]{2}$"},
        "value": {"type": "number"},
        "unit": {"type": "string"},
        "concept": {"type": "string"},
        "period_start": {"type": ["string", "null"]},
        "period_end": {"type": "string"},
        "accession": {"type": "string", "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"},
        "component_of": {"type": ["string", "null"]}
      }
    },
    "numeric_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "metric", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z]+_FY20[0-9]{2}:[a-z_]+:numeric_change$"},
        "metric": {"type": "string"},
        "status": {"enum": ["large_numeric_change", "gray_zone", "unchanged", "concept_change", "abstain"]},
        "abstain_reason": {"enum": ["not_reported", "ambiguous_concept", null]},
        "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
        "absolute_change": {"type": ["number", "null"]},
        "percent_change": {"type": ["number", "null"]},
        "pp_change": {"type": ["number", "null"]},
        "change_basis": {"enum": ["percent", "magnitude_only", "percentage_points", "sign_change", "zero_base", null]},
        "direction": {"type": ["string", "null"]},
        "warnings": {"type": "array", "items": {"enum": ["scope", "concept_change", "superseded_value", "period_mismatch"]}}
      }
    },
    "revision_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "metric", "period", "as_presented", "revised"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z]+_FY20[0-9]{2}:[a-z_]+:FY20[0-9]{2}:revision_control$"},
        "metric": {"type": "string"},
        "period": {"type": "string", "pattern": "^FY20[0-9]{2}$"},
        "as_presented": {"$ref": "#/$defs/fact"},
        "first_reported": {"oneOf": [{"$ref": "#/$defs/fact"}, {"type": "null"}]},
        "revised": {"type": "boolean"},
        "cause": {"enum": ["stock_split", "accounting_recast", null]}
      }
    },
    "item1a_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "earlier_text", "later_text"],
      "properties": {
        "label": {"enum": ["material_added", "material_removed", "material_modified"]},
        "earlier_text": {"type": ["string", "null"]},
        "later_text": {"type": ["string", "null"]},
        "summary": {"type": "string"}
      }
    }
  }
}
