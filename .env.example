# Copy to .env and fill in. Real environment variables take precedence.

# Required by the SEC for downloads (https://www.sec.gov/os/accessing-edgar-data):
# a name and a contact email. Only `secqa setup` sends it.
SEC_USER_AGENT="Your Name your.email@example.com"

# Optional
# SECQA_DATA_DIR=./data          # downloaded filings, XBRL facts and the search index
# SECQA_SNAPSHOT=2026-10-16      # ignore filings after this date (reproduces the evaluated data)
# OLLAMA_HOST=http://localhost:11434
# SECQA_MODEL=qwen3:8b
